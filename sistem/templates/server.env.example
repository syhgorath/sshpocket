# sshpocket sunucu ayarı ŞABLONU.
# Gerçek dosya: servers/<ad>/server.env  (git'e girmez, hiçbir zaman çalıştırılmaz; yalnızca okunur)
# Sunucu eklemek için menüden "Yeni sunucu ekle" ya da: bash sistem/ModuleGenerator.sh
# Gizli bilgi (parola, passphrase) BURAYA YAZILMAZ; passphrase macOS Keychain'dedir.
IP=
USER=
PORT=22
# KEY=/yol/mevcut_private_key      # (ops.) varsayılan: servers/<ad>/id_ed25519_<ad>
# OS=ubuntu-26.04                  # (ops.) hardening profili
# KNOCK=keychain                   # (ops.) bağlanmadan önce port knocking; dizi Keychain'de (menü: Knock ayarları)
# KNOCK_PROTO=tcp                  # tcp | udp
# KNOCK_DELAY_MS=300               # vuruşlar arası bekleme (0-5000)
